# --- Environment Variables for the QuantumTrust Project ---
# This file configures the backend server's connection to the live Ethereum Sepolia testnet.

# --- Blockchain Connection ---

# WEB3_PROVIDER_URI
# This is your personal gateway to the Sepolia blockchain.
# How to get it:
# 1. Create a free account at alchemy.com.
# 2. Create a new "App" for the "Ethereum" chain and "Sepolia" network.
# 3. Click on your new app, then "API Key", and copy the "HTTPS" URL.
WEB3_PROVIDER_URI="YOUR_ALCHEMY_HTTPS_URL"

# --- Server Wallet Configuration ---
# This is the wallet the backend server uses to pay gas fees for "Generate & Store" transactions.
# It must be an account that has been funded with Sepolia test ETH from a faucet.

# PRIVATE_KEY
# This is the secret key for the server's wallet. Keep it secret!
# How to get it:
# 1. In MetaMask, select the funded account.
# 2. Click the three dots (⋮) -> "Account details" -> "Show private key".
# 3. Copy the key and add "0x" to the beginning.
PRIVATE_KEY="0xYOUR_METAMASK_PRIVATE_KEY"

# DEPLOYER_ADDRESS
# This is the public address that corresponds to the private key above.
# How to get it:
# 1. In MetaMask, select the funded account.
# 2. Click on the address at the top (it starts with 0x) to copy it.
DEPLOYER_ADDRESS="YOUR_METAMASK_PUBLIC_ADDRESS"

# --- Network Configuration ---

# CHAIN_ID
# This is the unique identifier for the Sepolia test network.
# This value is always the same for Sepolia.
CHAIN_ID="11155111"